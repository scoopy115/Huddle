# Python engine
engine/.venv/
engine/**/__pycache__/
engine/.pytest_cache/
engine/.ruff_cache/
*.pyc

# Node / Vite
apps/desktop/node_modules/
apps/desktop/dist/

# Rust / Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# OS
.DS_Store

# Local data & models never belong in git
*.gguf
*.wav
# never any environment file, whatever the suffix
.env
.env.*
*.env

# bundled speaker models (fetched by scripts/fetch-speaker-models.sh)
apps/desktop/src-tauri/resources/models/

# build output kept out of iCloud Desktop & Documents sync
*.nosync/

# generated by PyInstaller / scripts (rebuilt on demand)
engine/*.spec
apps/desktop/src-tauri/binaries/

# internal engineering notes (decisions, audit, packaging) stay local
docs/
CHANGELOG.md

# certificates, signing keys and provisioning profiles never belong in git
*.p12
*.pfx
*.cer
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
AuthKey_*

# local assistant/tooling state
.claude/
